<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/syllabusFragment">

    <fragment
        android:id="@+id/syllabusFragment"
        android:name="com.aksharadeeptutor.ui.syllabus.SyllabusFragment"
        android:label="Syllabus Tracker">
        <action
            android:id="@+id/action_syllabus_to_quiz"
            app:destination="@id/quizFragment" />
    </fragment>

    <fragment
        android:id="@+id/quizFragment"
        android:name="com.aksharadeeptutor.ui.quiz.QuizFragment"
        android:label="Quiz Mode">
        <argument
            android:name="chapterId"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="chapterName"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/strengthMapFragment"
        android:name="com.aksharadeeptutor.ui.strengthmap.StrengthMapFragment"
        android:label="Strength Map" />

    <fragment
        android:id="@+id/dailyGoalFragment"
        android:name="com.aksharadeeptutor.ui.dailygoal.DailyGoalFragment"
        android:label="Daily Goals" />

</navigation>
